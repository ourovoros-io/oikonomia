{
  // Extends the app config so tests can never be checked more loosely than the code they test.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests run under Node, so they reach for its modules as well as the app's Vite types.
    "types": ["vite/client", "node"]
  },
  // Exactly the files tsconfig.app.json excludes; change the two lists together.
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testutil.ts",
    "src/test",
    "marketing/**/*.test.ts"
  ],
  "exclude": []
}
